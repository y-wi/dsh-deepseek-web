{
  "name": "dsh-deepseek-web-public-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
